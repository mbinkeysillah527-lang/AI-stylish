# ProofBeforeBuild Environment Variables

# ─── Supabase (pre-populated, do not change) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Server-side only (configured as edge function secrets, NOT in frontend) ───
# OPENAI_API_KEY=  — Set this as a Supabase edge function secret to enable real AI analysis.
#                   Without it, the app runs in demo mode with pre-loaded example data.
#                   To configure: add it via the Supabase dashboard or CLI as a secret for the pbb-analyze function.
# SUPABASE_SERVICE_ROLE_KEY=  — Pre-populated in the hosted environment. Never expose in frontend code.

# ─── Research API (optional, future) ───
# RESEARCH_API_KEY=  — If a web search API is configured, the edge function can retrieve live sources.
#                      Currently, the AI uses its training data for evidence. This is a planned enhancement.
